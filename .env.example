# ---------------------------------------------------------------------------
# Exasol Personal (local, Podman) - primary platform
# ---------------------------------------------------------------------------
# Host/port written by the Exasol Personal starter kit.
EXASOL_HOST=127.0.0.1
EXASOL_PORT=8563
EXASOL_USER=sys
# Put the password in .env only. It is gitignored and must never be committed.
EXASOL_PASSWORD=
EXASOL_SCHEMA=CREDENCEIQ
# Personal permits at most 5 concurrent sessions; keep the API pool small.
EXASOL_POOL_SIZE=3
# Local Personal uses a self-signed certificate, so this stays false.
# Set true when connecting to a CA-signed Exasol endpoint.
EXASOL_TLS_VERIFY=false

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# LLM (optional). The demo defaults to deterministic, offline letters.
# Supported: none | openai | anthropic | local
# For Ollama, keep model weights on D: (see README) and set:
#   LLM_PROVIDER=local
#   LOCAL_LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:7b-instruct
# Never commit API keys.
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, ...)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local

# ---------------------------------------------------------------------------
# Adverse action / credit decision letter header (synthetic NBFC)
# ---------------------------------------------------------------------------
LENDER_NAME=CredenceIQ Finance Ltd.
LENDER_ADDRESS=Bandra Kurla Complex, Mumbai, Maharashtra 400051
LENDER_PHONE=+91-22-5550-0142
LENDER_EMAIL=adverse.action@credenceiq.example

# ---------------------------------------------------------------------------
# Frontend (also set in frontend/.env.local for local development)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
