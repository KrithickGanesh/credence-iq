# ---------------------------------------------------------------------------
# Exasol Personal
# ---------------------------------------------------------------------------
EXASOL_HOST=localhost
EXASOL_PORT=8563
EXASOL_USER=sys
EXASOL_PASSWORD=exasol
EXASOL_SCHEMA=CREDENCEIQ
EXASOL_POOL_SIZE=8

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# LLM (optional). Set LLM_PROVIDER=none to use the deterministic compliance
# template fallback. Supported: none | openai | anthropic | local
# ---------------------------------------------------------------------------
LLM_PROVIDER=none
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01

# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, ...)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=local

# ---------------------------------------------------------------------------
# Adverse action letter header
# ---------------------------------------------------------------------------
LENDER_NAME=CredenceIQ Demo Bank, N.A.
LENDER_ADDRESS=100 Market Street, San Francisco, CA 94105
LENDER_PHONE=1-800-555-0142
LENDER_EMAIL=adverse.action@credenceiq.example

# ---------------------------------------------------------------------------
# Frontend (also set in frontend/.env.local for local development)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
